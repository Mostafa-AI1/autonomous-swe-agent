# ==============================================================================
# Autonomous SWE Agent - Environment Configuration
# ==============================================================================

# Execution Mode: "production" (interactive CLI + HITL) or "benchmark" (headless, zero-HITL)
SWE_EXECUTION_MODE=production

# Model Provider Settings
# Primary Cloud Option: Gemini 3.8 Flash (via Google AI Studio or LiteLLM)
SWE_PRIMARY_MODEL=gemini/gemini-3.8-flash
GEMINI_API_KEY=your_gemini_api_key_here

# Local Fallback Option: Qwen3-Coder (via Ollama or local vLLM)
SWE_FALLBACK_MODEL=ollama/qwen3-coder:latest
OLLAMA_BASE_URL=http://localhost:11434

# Execution Sandbox Configuration
SWE_SANDBOX_IMAGE=swe-sandbox:latest
SWE_SANDBOX_TIMEOUT_SECONDS=120
SWE_SANDBOX_MEMORY_LIMIT=2g
SWE_SANDBOX_CPU_LIMIT=2.0

# Trajectory & Telemetry
SWE_LOG_LEVEL=INFO
SWE_TRAJECTORY_DIR=./trajectories
SWE_ENABLE_LANGFUSE=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
