# syntax=docker/dockerfile:1
FROM python:3.11-slim-bookworm

# Prevent interactive prompts during package installs
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Install system dependencies, git, ripgrep (for fast code search), and basic build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ripgrep \
    curl \
    build-essential \
    procps \
    diffutils \
    patch \
    jq \
    && rm -rf /var/lib/apt/lists/*

# Install modern Python testing and linting tools into the sandbox environment
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir \
    pytest \
    pytest-cov \
    ruff \
    pip-tools

# Create a non-privileged user 'agent' to run code execution safely
RUN useradd -m -s /bin/bash -u 1000 agent && \
    mkdir -p /workspace && \
    chown -R agent:agent /workspace

# Set default working directory
WORKDIR /workspace
USER agent

# Default entrypoint for bash command execution
CMD ["/bin/bash"]
